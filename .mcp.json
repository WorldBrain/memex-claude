{
    "mcpServers": {
        "memex": {
            "type": "http",
            "url": "https://memex.garden/api/mcp"
        },
        "memex-realtime": {
            "type": "stdio",
            "command": "node",
            "args": [
                "${CLAUDE_PLUGIN_ROOT}/mcp/realtime-server.mjs"
            ],
            "env": {
                "MEMEX_REALTIME_STATE_DIR": "${CLAUDE_PLUGIN_DATA}"
            }
        }
    }
}
